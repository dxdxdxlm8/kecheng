# ============================================================
# 数据库（Supabase / PostgreSQL）
# 必填。复制本文件为 .env.local 后填写真实值。
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 服务端建议填写 service role key，可绕过 RLS；留空则回退到 anon key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# 大模型配置（可选）
# 教师端「系统设置」页面保存的配置优先级更高；
# 这里填写的值作为未配置时的兜底默认值。
# 兼容任意 OpenAI Chat Completions 协议的服务。
# ============================================================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=deepseek-chat
# 视觉模型：学生上传图片作答时用于识别；留空则回退到 LLM_MODEL
LLM_VISION_MODEL=
# 采样温度
LLM_TEMPERATURE=0.3
# 单次最大输出 token，留空表示不限制
LLM_MAX_TOKENS=
# 请求超时（毫秒）
LLM_TIMEOUT_MS=120000
# 额外请求头，JSON 对象字符串，例如 {"X-Api-Key":"xxx"}
LLM_EXTRA_HEADERS=

# ============================================================
# 对象存储（可选，仅「图片作答」功能需要）
# 支持 MinIO / R2 / 腾讯云 COS / 阿里云 OSS / AWS S3 等 S3 兼容服务
# ============================================================
STORAGE_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
STORAGE_REGION=ap-guangzhou
STORAGE_BUCKET=your-bucket
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 公开访问域名；填写后直接使用该域名拼 URL，不再做预签名
STORAGE_PUBLIC_BASE_URL=
# path-style：bucket 放路径中。自建/内网服务填 true，公有云可填 false
STORAGE_FORCE_PATH_STYLE=true
